<!DOCTYPE html>
<html lang="ru"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Лилии ASCII</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Marck+Script&display=swap">
<style>
html,body{height:100%;margin:0;overflow:hidden}
body{background:#050506;display:flex;align-items:center;justify-content:center}
#wrap{position:relative}
canvas{display:block;width:100%;height:100%}
#txt{position:absolute;left:0;right:0;bottom:7%;text-align:center;pointer-events:none;
font-family:"Marck Script","Segoe Script","Bradley Hand","Brush Script MT","Apple Chancery","URW Chancery L",cursive;
color:#ffe6f2;line-height:1.15;text-shadow:0 0 .35em rgba(255,90,170,.85),0 0 .9em rgba(255,60,150,.55),0 .06em .12em rgba(0,0,0,.8)}
.line{display:block}
.w{display:inline-block;white-space:nowrap;margin:0 .12em}
.c{display:inline-block;opacity:0;transform:translateY(.25em) scale(.9);filter:blur(.12em);transition:opacity .6s ease,transform .6s ease,filter .6s ease;white-space:pre}
.c.on{opacity:1;transform:none;filter:none}
#start{position:absolute;inset:0;display:none;align-items:center;justify-content:center;background:rgba(5,5,6,.55);color:#ffe6f2;font:20px "Marck Script","Segoe Script",cursive,sans-serif;cursor:pointer;text-align:center;padding:16px}
</style></head><body>
<div id="wrap"><canvas id="cv" width="1200" height="2136"></canvas><div id="txt"></div></div>
<div id="start">коснитесь экрана</div>
<audio id="au" src="data:audio/mpeg;base64," preload="auto" loop></audio>
<script>
var B64="";
(function(){
var W=100,H=89,FPS=15,CW=12,CH=24,RAMP=" .:-=+*#%@";
var LINES=["Я тебя безумно","сильно люблю,","родная моя"];
var T0=1.0,T1=5.5;
var cv=document.getElementById("cv"),ctx=cv.getContext("2d"),au=document.getElementById("au");
var wrap=document.getElementById("wrap"),txt=document.getElementById("txt"),startEl=document.getElementById("start");
var bin=atob(B64),len=bin.length,u8=new Uint8Array(len);
for(var i=0;i<len;i++)u8[i]=bin.charCodeAt(i);
var data=new Uint16Array(u8.buffer),N=data.length/(W*H),dur=N/FPS;
B64=null;
var letters=[];
LINES.forEach(function(l){var d=document.createElement("span");d.className="line";
 l.split(" ").forEach(function(word){var w=document.createElement("span");w.className="w";
  word.split("").forEach(function(ch){var c=document.createElement("span");c.className="c";c.textContent=ch;w.appendChild(c);letters.push(c)});
  d.appendChild(w);d.appendChild(document.createTextNode(" "))});
 txt.appendChild(d)});
function fit(){var aw=window.innerWidth,ah=window.innerHeight,r=cv.width/cv.height,w=aw,h=aw/r;
 if(h>ah){h=ah;w=ah*r}wrap.style.width=w+"px";wrap.style.height=h+"px";txt.style.fontSize=(w*0.115)+"px"}
window.addEventListener("resize",fit);fit();
var cols={};
function css(v){var c=cols[v];if(!c){c="rgb("+((v>>8)&15)*17+","+((v>>4)&15)*17+","+(v&15)*17+")";cols[v]=c}return c}
ctx.font="700 "+(CH-2)+"px Menlo,Consolas,'DejaVu Sans Mono',monospace";ctx.textAlign="center";ctx.textBaseline="middle";
var cur=-1;
function draw(f){if(f===cur)return;cur=f;ctx.fillStyle="#050506";ctx.fillRect(0,0,cv.width,cv.height);var o=f*W*H;
for(var y=0;y<H;y++)for(var x=0;x<W;x++){var w=data[o+y*W+x],k=w>>12;if(!k)continue;ctx.fillStyle=css(w&4095);ctx.fillText(RAMP.charAt(k),x*CW+CW/2,y*CH+CH/2)}}
var raf=window.requestAnimationFrame||function(f){return setTimeout(f,16)};
var running=false,t=0,last=Date.now(),shown=-1;
function showText(){var p=Math.max(0,Math.min(1,(t-T0)/(T1-T0)));var n=Math.round(p*letters.length);
 if(n===shown)return;shown=n;for(var i=0;i<letters.length;i++){letters[i].className=i<n?"c on":"c"}}
function tick(){var now=Date.now(),dt=(now-last)/1000;last=now;
 if(running){if(!au.paused&&au.readyState>1){t=au.currentTime%dur}else{t=(t+dt)%dur}}
 draw(Math.min(N-1,Math.floor(t*FPS)));showText();raf(tick)}
function begin(){running=true;startEl.style.display="none";last=Date.now()}
function tryPlay(){try{au.currentTime=0}catch(e){}
 var p=au.play();
 if(p&&p.then){p.then(begin,function(){startEl.style.display="flex";t=T1+1;
   var go=function(){document.removeEventListener("click",go);document.removeEventListener("touchend",go);document.removeEventListener("keydown",go);t=0;shown=-1;
     try{au.currentTime=0}catch(e){}var q=au.play();if(q&&q.catch)q.catch(function(){});begin()};
   document.addEventListener("click",go);document.addEventListener("touchend",go);document.addEventListener("keydown",go)})}
 else begin()}
draw(0);raf(tick);tryPlay();
})();
</script></body></html>
